          }
          m: "GET"
          o: "/data-deletions/v3.0/{tracking_id}"
          q: {
            exist: [
              "token"
              "tracking_id"
            ]
          }
          s: [
            {
              lit: "data-deletions"
            }
            {
              lit: "v3.0"
            }
